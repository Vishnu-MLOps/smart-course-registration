PORT=5000
NODE_ENV=production

# MongoDB Atlas URI (Use your MongoDB Atlas cluster connection string)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_course_registration?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/smart_course_registration?retryWrites=true&w=majority

# JWT secret key for signing tokens
JWT_SECRET=super_secret_production_jwt_key_here

# Deployed frontend URL (Vercel) or comma-separated list
CLIENT_URL=https://smart-course-registration.vercel.app

